{
  "name": "decky-pw-ac3-live",
  "version": "0.1.0",
  "description": "Encodes 5.1 game audio to Dolby Digital (AC-3) over HDMI, so TVs, soundbars and receivers that only accept stereo PCM still get real surround sound.",
